{
  "compilerOptions": {
    "target": "ES2023",
    // The SDK's schema, lens, and chain handles implement `Disposable`,
    // so `using` needs the disposable declarations.
    "lib": ["ES2023", "ESNext.Disposable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true
  },
  "include": ["src"]
}
